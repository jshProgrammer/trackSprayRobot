<?xml version="1.0"?>
<robot name="track_spray_robot_spray" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= Chassis ================= -->
  <link name="base_link">
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.8"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
      <material name="grey">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision name="lidar_ignore" laser="false">
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
    </collision>
  </link>

  <!-- ================= Dummy Link for KDL Workaround ================= -->
  <link name="base_footprint">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- ================= Wheels ================= -->
  <!-- LEFT WHEEL -->
  <link name="wheel_left">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1"/>
      </material>
    </visual>
    <collision name="lidar_ignore" laser="false">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- RIGHT WHEEL -->
  <link name="wheel_right">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1"/>
      </material>
    </visual>
    <collision name="lidar_ignore" laser="false">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- BACK WHEEL (Castor wheel) -->
  <link name="caster_wheel">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1"/>
      </material>
    </visual>
    <collision name="lidar_ignore" laser="false">
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- ================= Sensors ================= -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.1"/>
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1"/>
      </material>
    </visual>
    <!--<collision name="lidar_ignore" laser="false">
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>-->
  </link>

  <link name="ultrasound_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.05 0.05 0.02"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 1.0 1"/>
      </material>
    </visual>
  </link>

  <!-- ================= Joints ================= -->
  <!-- LEFT WHEEL JOINT -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <origin xyz="-0.1 0.15 -0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics friction="0.1"/>
  </joint>

  <!-- RIGHT WHEEL JOINT -->
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <origin xyz="-0.1 -0.15 -0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics friction="0.1"/>
  </joint>

  <!-- BACK CASTOR WHEEL JOINT -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.25 0 -0.1" rpy="0 0 0"/>
  </joint>

  <!-- LIDAR JOINT -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- ULTRASONIC JOINT -->
  <joint name="ultrasound_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasound_link"/>
    <origin xyz="0.25 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- ================= Gazebo Plugins ================= -->
  <!-- Differential Drive Plugin -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_link</robotBaseFrame>
      <publishWheelTF>true</publishWheelTF>
      <publishOdom>true</publishOdom>
      <updateRate>100</updateRate>
      <leftJoint>wheel_left_joint</leftJoint>
      <rightJoint>wheel_right_joint</rightJoint>
      <wheelSeparation>0.3</wheelSeparation>
      <wheelDiameter>0.15</wheelDiameter>
      <wheelAcceleration>1.0</wheelAcceleration>
      <wheelTorque>20</wheelTorque>
      <odometrySource>world</odometrySource>
    </plugin>
  </gazebo>

  <!-- LiDAR Plugin -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle>3.14159265359</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.05</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
        <!--<ros>
          <namespace>robot</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>-->
        <topicName>robot/scan</topicName>
        <frameName>lidar_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ================= Transmissions ================= -->
  <transmission name="left_wheel_trans" type="transmission_interface/SimpleTransmission">
    <actuator name="left_motor"/>
    <joint name="wheel_left_joint"/>
    <mechanicalReduction>1</mechanicalReduction>
  </transmission>

  <transmission name="right_wheel_trans" type="transmission_interface/SimpleTransmission">
    <actuator name="right_motor"/>
    <joint name="wheel_right_joint"/>
    <mechanicalReduction>1</mechanicalReduction>
  </transmission>

  <!-- ================= Spray-Stab Link ================= -->
  <link name="spray_link">
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <!-- Zylinder haengt nach unten: Origin ist Mitte des Stabes -->
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.20"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.4 0.0 1.0"/>
      </material>
    </visual>
    
  </link>

  <!-- ================= Spray-Stab Joint ================= -->
  <!--
    Prismatisch: Stab faehrt in -Z-Richtung (nach unten) aus der Basis heraus.
      lower="0.0"  -> Stab oben  (eingezogen,  STROKE_UP_M   in der Node)
      upper="0.10" -> Stab unten (ausgefahren, STROKE_DOWN_M in der Node)
    Einbaupunkt: mittig auf der Unterseite des Chassis (z = -0.10 = halbe Chassis-Hoehe).
  -->
  <joint name="spray_joint" type="prismatic">
    <parent link="base_link"/>
    <child  link="spray_link"/>
    <origin xyz="0.0 0.0 -0.10" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="0.10" effort="30.0" velocity="0.3"/>
    <dynamics damping="1.0" friction="0.05"/>
  </joint>

  <!-- ================= Transmission fuer ros_control ================= -->
  <transmission name="spray_trans"
                type="transmission_interface/SimpleTransmission">
    <actuator name="spray_motor"/>
    <joint name="spray_joint"/>
    <mechanicalReduction>1</mechanicalReduction>
  </transmission>


</robot>