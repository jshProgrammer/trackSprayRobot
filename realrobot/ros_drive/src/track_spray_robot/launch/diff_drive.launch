<launch>
    <rosparam file="$(find track_spray_robot)/config/motor.yaml" command="load"/>
	<rosparam file="$(find track_spray_robot)/config/rtk_credentials.yaml" command="load"/>

	<!-- Emergency node -->
	<node pkg="track_spray_robot" type="emergency_kill.py" name="emergency_kill" output="screen"/>
	
	<!-- Motor node -->
	<node name="motor_driver" pkg="track_spray_robot" type="pwm_drive.py"
		output="screen" respawn="true" respawn_delay="1"/>


	<!-- GPS and RTK nodes-->
	<!-- This node only publishes the gps information on /gps/fix and does not print out any coordinates! !!!-->
	<node name="gps_node" pkg="track_spray_robot" type="gps_node.py"
		output="screen"/>
	<node name="ntrip_client" pkg="track_spray_robot" type="ntrip_client.py" output="screen"/>

	<!-- Joystick nodes-->
	<node pkg="joy" type="joy_node" name="joy_node">
		<param name="device_id"       value="0"/>
		<param name="deadzone"        value="0.1"/>
		<param name="autorepeat_rate" value="20"/>
	</node>
	<node pkg="teleop_twist_joy" type="teleop_node" name="teleop_twist_joy">
		<param name="axis_linear"           value="1"/>  <!-- Linker Stick Y -->
		<param name="axis_angular"          value="3"/>  <!-- Rechter Stick X -->
		<param name="scale_linear"          value="0.5"/>
		<param name="scale_angular"         value="1.0"/>
		<param name="enable_button"         value="4"/>  <!-- L1 = Totmann -->
		<param name="enable_turbo_button"   value="5"/>  <!-- R1 = Turbo -->
        <remap from="cmd_vel" to="/cmd_vel"/>
	</node>
	<node pkg="track_spray_robot" type="joystick.py" name="joystick_node" output="screen">
		<param name="max_linear" value="0.5"/>
		<param name="max_angular" value="1.0"/>
	</node>
</launch>
