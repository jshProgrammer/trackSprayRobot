<?xml version="1.0"?>
<package format="2">
  <name>mpu9250_node</name>
  <version>0.1.0</version>
  <description>ROS Noetic node for MPU9250 9-DOF IMU sensor (Accelerometer, Gyroscope, Magnetometer)</description>

  <maintainer email="jshprogrammer@example.com">jshProgrammer</maintainer>
  <license>MIT</license>

  <author email="jshprogrammer@example.com">jshProgrammer</author>

  <buildtool_depend>catkin</buildtool_depend>
  
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-smbus</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>

</package>